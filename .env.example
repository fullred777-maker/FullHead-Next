# Required isolation marker. The app refuses to start with another value.
VITE_FULLHEAD_ENV=next-testing

# Firebase web app from the isolated TEST project only.
VITE_FIREBASE_API_KEY=replace_with_test_value
VITE_FIREBASE_AUTH_DOMAIN=replace_with_test_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_test_project
VITE_FIREBASE_STORAGE_BUCKET=replace_with_test_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_test_value
VITE_FIREBASE_APP_ID=replace_with_test_value
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Server-only integrations. Keep commerce disabled in the Next environment.
FULLHEAD_ENV=next-testing
FULLHEAD_ENABLE_COMMERCE=false
HOTMART_HOTTOK=
RESEND_API_KEY=
RESEND_FROM=
APP_LINK=
